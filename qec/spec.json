{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumetzchaim.com/spec/v0.1/qec-program.schema.json",
  "title": "QEC Program v0.1",
  "type": "object",
  "required": ["schemaVersion", "program", "capabilities", "budget", "alephOlam", "contentHash"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "program": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "budget": {
      "type": "object",
      "required": ["steps"],
      "properties": {"steps": {"type": "integer", "minimum": 1, "maximum": 10000}},
      "additionalProperties": false
    },
    "alephOlam": {
      "type": "object",
      "required": ["enabled", "capabilityGrant"],
      "properties": {
        "enabled": {"const": false},
        "capabilityGrant": {"const": false}
      },
      "additionalProperties": false
    },
    "contentHash": {"type": "string"}
  },
  "additionalProperties": false
}
